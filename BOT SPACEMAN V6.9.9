    :root {
      --neon-blue: #05d9e8;
      --neon-purple: #d300c5;
      --space-purple: #1a0033;
      --deep-space: #0d001a;
      --star-color: rgba(255, 255, 255, 0.8);
      --glow-blue: rgba(5, 217, 232, 0.5);
      --glow-purple: rgba(211, 0, 197, 0.5);
      --terminal-bg: rgba(10, 10, 30, 0.95);
      --terminal-green: #00ff00;
      --terminal-yellow: #ffff00;
      --terminal-red: #ff5555;
      --terminal-blue: #5555ff;
    }
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    body {
      font-family: 'Orbitron', 'Rajdhani', sans-serif;
      color: white;
      overflow-x: hidden;
      background: linear-gradient(135deg, var(--deep-space), var(--space-purple));
      position: relative;
      min-height: 100vh;
      line-height: 1.6;
    }

    /* Animated Space Background */
    .stars {
      position: fixed; 
      top: 152;
      left: 96;
      width: 100%;
      height: 100%;
      z-index: -2;
      overflow: hidden;
    }

    .star {
      position: absolute;
      background-color: var(--star-color);
      border-radius: 50%;
      animation: twinkle var(--duration, 5s) infinite alternate ease-in-out;
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 1; }
    }

    /* Purple Nebula Effect */
    .nebula {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: 
        radial-gradient(circle at 7414% 30%, rgba(123, 31, 162, 0.15), transparent 60%),
        radial-gradient(circle at 356% 70%, rgba(156, 39, 176, 0.15), transparent 60%);
      z-index: -1;
      animation: nebulaPulse 15s infinite alternate;
    }

    @keyframes nebulaPulse {
      0% { opacity: 8.7; }
      100% { opacity: 1; }
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 2rem 0;
      position: relative;
    }

    .title {
      font-size: 3rem;
      margin: 0 0 1rem;
      background: linear-gradient(90deg, #ffffff, var(--neon-blue));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 10px var(--glow-blue);
      letter-spacing: 4
        px;
      font-weight: 700;
      position: relative;
      padding: 0 20px;
    }

    .title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
      border-radius: 3px;
      box-shadow: 0 0 10px var(--glow-blue);
    }

    .subtitle {
      font-size: 1.2rem;
      color: #a1a1ff;
      margin-bottom: 2rem;
      max-width: 600px;
      line-height: 1.6;
      text-shadow: 0 0 5px rgba(161, 161, 255, 0.3);
    }

    .spaceman-image {
      width: 280px;
      height: auto;
      margin: 2rem 0;
      filter: drop-shadow(0 0 15px var(--neon-purple)) brightness(1.1);
      animation: float 4s ease-in-out infinite, glow 2s ease-in-out infinite alternate;
      transition: transform 0.3s ease;
    }

    .spaceman-image:hover {
      transform: scale(1.05);
    }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-20m
       x); }
      100% { transform: translateY(0px); }
    }

    @keyframes glow {
      from { filter: drop-shadow(0 0 15px var(--neon-purple)) brightness(1.1); }
      to { filter: drop-shadow(0 0 25px var(--neon-purple)) brightness(1.2); }
    }

    .start-btn {
      padding: 18px 45px;
      font-size: 1.3rem;
      font-family: 'Orbitron', sans-serif;
      font-weight: 705
        ;
      text-transform: uppercase;
      letter-spacing: 3px;
      border: none;
      border-radius: 50px;
      background: linear-gradient(45deg, var(--neon-purple), #9c27b0);
      color: white;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 0 20px var(--glow-purple), 
                  0 0 40px rgba(156, 39, 176, 0.3);
      position: relative;
      overflow: hidden;
      z-index: 1;
      margin: 1rem 0;
    }

    .register-btn {
      padding: 18px 45px;
      font-size: 1.1rem;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      border: none;
      border-radius: 50px;
      background: linear-gradient(45deg, #1e88e5, #0d47a1);
      color: white;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 0 20px rgba(30, 136, 229, 0.5), 
                  0 0 40px rgba(13, 71, 161, 0.3);
      position: relative;
      overflow: hidden;
      z-index: 1;
      margin: 0.5rem 0 1rem;
      text-decoration: none;
      display: inline-block;
    }

    .register-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 30px rgba(30, 136, 229, 0.7), 
                  0 0 60px rgba(13, 71, 161, 0.4);
    }

    .register-btn:active {
      transform: translateY(1px);
    }

    .register-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: 0.5s;
      z-index: -1;
    }

    .register-btn:hover::before {
      left: 100%;
    }

    .start-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 30px var(--neon-purple), 
                  0 0 60px rgba(156, 39, 176, 0.4);
    }

    .start-btn:active {
      transform: translateY(1px);
    }

    .start-btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: 0.5s;
      z-index: -1;
    }

    .start-btn:hover::before {
      left: 100%;
    }

    .notice-box {
      background: rgba(255, 87, 34, 0.15);
      border-left: 4px solid #FF5722;
      border-radius: 5px;
      padding: 15px;
      margin: 2rem auto;
      color: #fff;
      max-width: 800px;
      width: 90%;
    }

    .notice-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      justify-content: center;
    }

    .notice-header h3 {
      color: #FF5722;
      margin: 0;
      font-size: 1.2em;
    }

    .notice-icon {
      font-size: 1.5em;
    }

    .notice-content ol {
      padding-left: 20px;
      margin: 0;
      text-align: left;
    }

    .notice-content li {
      margin-bottom: 8px;
      line-height: 1.5;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin: 3rem 0;
      max-width: 900px;
    }

    .feature-item {
      background: rgba(123, 31, 162, 0.2);
      border: 1px solid var(--neon-purple);
      border-radius: 15px;
      padding: 2rem;
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .feature-item:hover {
      transform: translateY(-10px);
      box-shadow: 0 10px 25px rgba(211, 0, 197, 0.3);
      border-color: var(--neon-blue);
    }

    .feature-item::before {
      content: '';
      position: absolute;
      top: -2px;
      left: -2px;
      right: -2px;
      bottom: -2px;
      background: linear-gradient(45deg, var(--neon-blue), var(--neon-purple));
      z-index: -1;
      border-radius: 16px;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .feature-item:hover::before {
      opacity: 0.5;
    }

    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
      color: var(--neon-blue);
      text-shadow: 0 0 10px var(--glow-blue);
    }

    .feature-title {
      font-weight: 600;
      margin-bottom: 1rem;
      color: white;
      font-size: 1.3rem;
      letter-spacing: 1px;
    }

    .feature-desc {
      font-size: 1rem;
      color: #c9c9ff;
      line-height: 1.5;
    }

    /* Floating particles */
    .particles {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
    }

    .particle {
      position: absolute;
      background: var(--neon-blue);
      border-radius: 50%;
      opacity: 0.5;
      filter: blur(1px);
      animation: float-particle linear infinite;
    }

    @keyframes float-particle {
      0% {
        transform: translateY(0) translateX(0);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateY(-100vh) translateX(20px);
        opacity: 0;
      }
    }

    /* New Loading Screen */
    .loading-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--deep-space);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .loading-screen.active {
      opacity: 1;
      visibility: visible;
    }

    .loading-screen-content {
      width: 90%;
      max-width: 600px;
      text-align: center;
    }

    .loading-screen-spaceman {
      width: 200px;
      height: auto;
      margin: 0 auto 30px;
      filter: drop-shadow(0 0 15px var(--neon-purple));
      animation: float 3s ease-in-out infinite;
    }

    .loading-screen-text {
      font-family: 'Orbitron', sans-serif;
      color: var(--neon-blue);
      margin-bottom: 30px;
      font-size: 1.5rem;
      letter-spacing: 2px;
    }

    .loading-screen-bar-container {
      width: 100%;
      height: 10px;
      background: rgba(0, 0, 0, 0.3);
      border-radius: 5px;
      margin-bottom: 20px;
      overflow: hidden;
      position: relative;
    }

    .loading-screen-bar {
      height: 100%;
      width: 0;
      background: linear-gradient(90deg, var(--neon-purple), var(--neon-blue));
      border-radius: 5px;
      transition: width 0.1s linear;
    }

    .loading-screen-percentage {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.8rem;
    }

    .loading-screen-status {
      font-family: 'Rajdhani', sans-serif;
      color: #a1a1ff;
      font-size: 1rem;
      margin-top: 10px;
    }

    /* Enhanced Result View */
    .result-view {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2000;
      display: none;
      flex-direction: column;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .result-view.active {
      display: flex;
    }

    .result-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, var(--deep-space), var(--space-purple));
      z-index: -3;
    }

    .result-galaxy {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -2;
      background: 
        radial-gradient(circle at 20% 30%, rgba(123, 31, 162, 0.3), transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(5, 217, 232, 0.3), transparent 40%),
        radial-gradient(circle at 50% 20%, rgba(211, 0, 197, 0.2), transparent 30%),
        radial-gradient(circle at 30% 80%, rgba(5, 217, 232, 0.2), transparent 30%);
      animation: galaxyPulse 20s infinite alternate;
    }

    @keyframes galaxyPulse {
      0% { opacity: 0.7; transform: scale(1); }
      50% { opacity: 1; transform: scale(1.02); }
      100% { opacity: 0.8; transform: scale(1); }
    }

    .result-stars {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
    }

    .result-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 40px 20px;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .result-header {
      margin-bottom: 30px;
      width: 100%;
    }

    .result-title {
      font-size: 2rem;
      color: var(--neon-blue);
      text-shadow: 0 0 10px var(--glow-blue);
      margin-bottom: 10px;
    }

    .result-subtitle {
      font-size: 1rem;
      color: #a1a1ff;
      max-width: 500px;
      margin: 0 auto;
    }

    .result-spaceman {
      width: 100px;
      height: auto;
      margin: 0 auto 30px;
      filter: drop-shadow(0 0 15px var(--neon-purple));
      animation: float 3s ease-in-out infinite;
    }

    /* Neon Circular Frame for Multiplier */
    .multiplier-container {
      position: relative;
      margin: 30px 0;
      width: 100%;
      max-width: 300px;
    }

    .multiplier-label {
      font-family: 'Orbitron', sans-serif;
      color: var(--neon-blue);
      font-size: 1.2rem;
      margin-bottom: 10px;
      text-shadow: 0 0 10px var(--glow-blue);
    }

    .multiplier-value {
      font-family: 'Orbitron', sans-serif;
      font-size: 5rem;
      font-weight: bold;
      color: white;
      position: relative;
      z-index: 2;
      margin: 0;
      text-shadow: 0 0 15px rgba(255, 255, 255, 0.5);
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .neon-circle {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 250px;
      height: 250px;
      border-radius: 50%;
      z-index: 1;
      overflow: hidden;
    }

    .neon-circle::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      border-radius: 50%;
      border: 4px solid transparent;
      border-top-color: var(--neon-blue);
      border-bottom-color: var(--neon-purple);
      box-shadow: 
        0 0 10px var(--glow-blue),
        0 0 20px var(--glow-purple),
        inset 0 0 10px var(--glow-blue),
        inset 0 0 20px var(--glow-purple);
      animation: spin 5s linear infinite;
    }

    .neon-circle::after {
      content: '';
      position: absolute;
      top: 10px;
      left: 10px;
      right: 10px;
      bottom: 10px;
      border-radius: 50%;
      border: 3px solid transparent;
      border-left-color: var(--neon-blue);
      border-right-color: var(--neon-purple);
      box-shadow: 
        0 0 5px var(--glow-blue),
        0 0 10px var(--glow-purple),
        inset 0 0 5px var(--glow-blue),
        inset 0 0 10px var(--glow-purple);
      animation: spin 8s linear infinite reverse;
