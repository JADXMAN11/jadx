        radial-gradient(circle at 7414% 30%, rgba(123, 31, 162, 0.15), transparent 60%),
        radial-gradient(circle at 356% 70%, rgba(156, 39, 176, 0.15), transparent 60%);
      z-index: -1;
      animation: nebulaPulse 15s infinite alternate;
